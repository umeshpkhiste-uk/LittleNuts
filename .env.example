# Copy this file to apps/mobile/.env (git-ignored) and fill in real values.
# NEVER commit real credentials. NEVER put secret/service-role keys in
# EXPO_PUBLIC_* variables — those are bundled into the client app and are
# readable by anyone who installs it.

# --- Client-side (safe to expose, protected by Supabase RLS) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=development
# Razorpay "Key ID" only (never the key secret) — the client SDK needs this
# to open the checkout UI. The actual charge is created and verified
# server-side in supabase/functions.
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# --- Server-side only (Supabase Edge Function secrets, set via `supabase
# secrets set`, NEVER placed in this app's .env or any EXPO_PUBLIC_* var) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
